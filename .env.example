# Database Credentials (Change these for production)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=beemonitor
POSTGRES_SERVER=db
POSTGRES_PORT=5432

# Computed Connection String
DATABASE_URL=postgresql://postgres:your_secure_password_here@db:5432/beemonitor

# Frontend API URL (Accessed by client browser)
# Local development default: http://localhost:8000
# Production example: https://beehive.gouthamsreekumar.dev/api
NEXT_PUBLIC_API_URL=http://localhost:8000
